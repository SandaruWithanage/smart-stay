# Example local-only configuration. Copy to .env, do not commit secrets.
POSTGRES_DB=smartstay
POSTGRES_USER=smartstay
POSTGRES_PASSWORD=change-me-for-local-development
DB_URL=jdbc:postgresql://localhost:5432/smartstay
DB_USERNAME=smartstay
DB_PASSWORD=change-me-for-local-development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Generate a random 32-byte key: openssl rand -base64 32
# On PowerShell: $bytes = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Fill($bytes); [Convert]::ToBase64String($bytes)
SMARTSTAY_JWT_SECRET_BASE64=
# Optional one-time admin bootstrap. Do not leave bootstrap secrets configured after provisioning.
SMARTSTAY_BOOTSTRAP_ADMIN_EMAIL=
SMARTSTAY_BOOTSTRAP_ADMIN_PASSWORD=
